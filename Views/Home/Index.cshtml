@model IEnumerable<Asset>

@{
    ViewData["Title"] = "Home";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
<div class="mt-4">
    <div id="assetCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4000" data-bs-pause="hover">
        <div class="carousel-inner">

            <!-- Hero Carousel -->
            @if (Model != null && Model.Any())
            {
                var first = true;
                foreach (var asset in Model)
                {
                    <div class="carousel-item @(first ? "active" : "")">
                        <img src="@asset.ImageUrl" class="d-block w-100" style="height:200px; object-fit:cover;" alt="@asset.Name" />
                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3 animate__animated animate__fadeInUp">
                            <h3 class="fw-bold">@asset.Name</h3>
                            <p>@asset.Description</p>
                        </div>
                    </div>
                    first = false;
                }
            }
            else
            {
                <div class="carousel-item active">
                    <img src="~/Images/default.jpg" class="d-block w-100" style="height:500px; object-fit:cover;" alt="No assets" />
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                        <h3>No Assets Available</h3>
                        <p>Asset data will appear here once available.</p>
                    </div>
                </div>
            }

        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#assetCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#assetCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Next</span>
        </button>

        <!-- Indicators -->
        <div class="carousel-indicators">
            @if (Model != null && Model.Any())
            {
                var index = 0;
                foreach (var asset in Model)
                {
                    <button type="button" data-bs-target="#assetCarousel" data-bs-slide-to="@index" class="@(index == 0 ? "active" : "")" aria-current="@(index == 0 ? "true" : "false")"></button>
                    ;
                    index++;
                }
            }
        </div>
    </div>

    <!-- Overview Section -->
    <section class="py-5 bg-light text-center">
        <div class="container">
            <h2 class="text-primary mb-4">What Our System Does</h2>
            <p class="lead text-muted w-75 mx-auto">
                The <strong>University Asset Verification System</strong> helps streamline asset tracking and verification.
                It enables staff to submit reports, track reviews, and maintain accurate records of institutional property.
                Our goal is to improve accountability, transparency, and efficiency in asset management across all departments.
            </p>
        </div>
    </section>

    <!-- Author Section -->
    <section class="py-5">
        <div class="container text-center">
            <h2 class="text-primary mb-4">Meet the Team</h2>
            <div class="row justify-content-center">
                <div class="col-md-3 mb-4">
                    <div class="card border-0 shadow-sm">
                        <img src="~/Images/Orah.jpg" class="card-img-top rounded-circle mx-auto mt-3" style="width:150px; height:150px; object-fit:cover;" alt="Author">
                        <div class="card-body">
                            <h5 class="card-title">O. Seleke</h5>
                            <p class="text-muted">Developer</p>
                        </div>
                    </div>
                </div>

                <!-- Add more authors here -->
                <div class="col-md-3 mb-4">
                    <div class="card border-0 shadow-sm">
                        <img src="~/Images/Makubo.jpg" class="card-img-top rounded-circle mx-auto mt-3" style="width:150px; height:150px; object-fit:cover;" alt="Author">
                        <div class="card-body">
                            <h5 class="card-title">L.M Makubo</h5>
                            <p class="text-muted">Developer</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>