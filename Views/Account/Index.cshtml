@model List<KeyValuePair<AppUser,string>>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid m-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">User Management</h2>
        <a asp-action="Add" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add User
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Role</th>
                        
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Key.Id</td>
                            <td>@user.Key.UserName</td>
                            <td>@user.Key.Email</td>
                            <td>
                                <span class="badge bg-secondary">@user.Value</span>
                            </td>
                           
                            <td class="text-end">
                                
                               
                                   
                                    <a asp-action="Update" asp-route-id="@user.Key.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if(!user.Key.UserName.Equals("App_Admin")){
                                    <button class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-user-id="@user.Key.Id"
                                            data-username="@user.Key.UserName">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                }
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete user <strong id="userToDelete"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <form id="deleteForm" method="post" asp-action="Delete" asp-controller="Account">
                        <input type="hidden" name="id" id="deleteUserId" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

   
        <script>
            const deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-user-id');
                const username = button.getAttribute('data-username');

                document.getElementById('userToDelete').textContent = username;
                document.getElementById('deleteUserId').value = userId;
            });
        </script>
    
</div>
