@model IEnumerable<Submission>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Asset ID</th>
            <th>Asset Name</th>
            <th>Condition</th>
            <th>Location</th>
            <th>Staff</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-controller="Report" asp-route-id="@item.AssetId">
                        @item.AssetId
                    </a>
                </td>
                <td>@item.Asset?.Name</td>
                <td>@item.Condition</td>
                <td>@item.Location</td>
                <td>@item.Staff?.UserName</td>
                <td>@item.ReviewStatus</td>
            </tr>
        }
    </tbody>
</table>
